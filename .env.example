# ─────────────────────────────────────────────────────────────────────────
#  liquidation-detector -- GLOBAL config only.
#  Per-user secrets (Binance API keys, Telegram tokens, risk settings)
#  live in users.config.json instead -- see users.config.example.json.
# ─────────────────────────────────────────────────────────────────────────

# Symbols the single, global V5 strategy engine tracks.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,SUIUSDT

LOG_LEVEL=info

# ─── Binance (shared market-data connection only) ──────────────────────────
# Public WS streams (liquidation/kline/aggTrade/bookTicker/depth) do not
# require authentication. Leave blank unless you have a specific reason
# to authenticate the shared market-data REST client itself. Real
# per-user Binance execution uses EACH user's own apiKey/apiSecret from
# users.config.json -- never this one.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─── Mongo ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# The EXISTING liqwatch-bot database -- reused, read AND written for
# shared historical liq_minute_aggregates/wall_minute_aggregates only.
# This project never touches any other collection in this database.
MONGO_SHARED_DB=liqwatch_bot

# This project's OWN, independently-owned database -- v5_global_signals
# plus every per-user collection (v5_signals_<userId>,
# execution_records_<userId>, execution_claims_<userId>).
MONGO_OWN_DB=liquidation_detector

# ─── Users config ───────────────────────────────────────────────────────
# Path to the (gitignored) file with real per-user secrets. Copy
# users.config.example.json to users.config.json and fill in real values.
USERS_CONFIG_PATH=./users.config.json
